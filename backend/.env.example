# Database & Redis Connection
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/abeddy_assistant?schema=public"
REDIS_URL="redis://localhost:6379"

# AI Provider API Keys
ANTHROPIC_API_KEY="your-anthropic-api-key"
GEMINI_API_KEY="your-gemini-api-key"

# Server Port
PORT=3001

# Environment
NODE_ENV=development
TZ="Africa/Nairobi"

# Model IDs (change here when a model is retired)
PERSONA_MODEL="claude-opus-5-5"
TUTOR_MODEL="claude-opus-5-5"
GEMINI_MODEL="gemini-3.8-flash"

# Admin access: protects /api/qr and /api/status. Required in production (min 24 chars).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=""
# Dashboard origin allowed by CORS (leave empty to keep CORS closed)
DASHBOARD_ORIGIN=""
# Your own WhatsApp id for escalations, e.g. 2547XXXXXXXX@c.us
OWNER_WID=""
